{
  "name": "verbs-first",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rspack dev",
    "build": "rspack build",
    "typecheck": "tsc --noEmit",
    "audio": "tsx scripts/generate-audio.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "simple-git-hooks",
    "lexicon:check": "tsx --import ./scripts/css-stub.mjs scripts/lexicon-coverage.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@rspack/cli": "^2.3.1",
    "@rspack/core": "^2.3.1",
    "@rspack/dev-server": "^2.2.2",
    "@rspack/plugin-react-refresh": "^2.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.92.0",
    "react-refresh": "^0.19.0",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.18.0",
  "simple-git-hooks": {
    "pre-commit": "pnpm lint"
  }
}
