{
  "name": "verbs-first",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rspack dev",
    "build": "rspack build",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o dist-storybook --quiet",
    "audio": "tsx scripts/generate-audio.ts",
    "map:heights": "tsx scripts/build-heightmap.ts",
    "museum:fetch": "tsx scripts/museum-fetch.ts",
    "museum:bake": "tsx scripts/museum-bake.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "simple-git-hooks",
    "lexicon:check": "tsx --import ./scripts/css-stub.mjs scripts/lexicon-coverage.ts",
    "reading:check": "tsx scripts/reading-course-check.ts",
    "story:check": "tsx --import ./scripts/css-stub.mjs scripts/story-check.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@rspack/cli": "^2.3.1",
    "@rspack/core": "^2.3.1",
    "@rspack/dev-server": "^2.2.2",
    "@rspack/plugin-react-refresh": "^2.0.2",
    "@storybook/react-vite": "10.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "draco3dgltf": "^1.5.9",
    "meshoptimizer": "^1.3.0",
    "oxlint": "^1.92.0",
    "react-refresh": "^0.19.0",
    "sharp": "^0.35.5",
    "simple-git-hooks": "^2.14.0",
    "storybook": "10.6.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.8"
  },
  "packageManager": "pnpm@12.18.0",
  "simple-git-hooks": {
    "pre-commit": "pnpm lint"
  }
}
